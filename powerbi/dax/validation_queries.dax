// Brightwater Retail Phase 7: DAX validation queries.
// Run in Power BI Desktop: View > DAX query view > paste > Run. Every row must show PASS.
// Expected values come from the Python reference implementation, which reconciles to Phase 4, 5 and 6
// (reports/phase7/phase7_validation_checks.csv). Generated by src/powerbi/assets.py; do not edit by hand.

EVALUATE
VAR _cases =
    {
        ( "Net Revenue (H2 2025)", CALCULATE ( [Net Revenue], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 9457457.049999999, 0.01 ),
        ( "Net Revenue PY (H2 2025)", CALCULATE ( [Net Revenue PY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 10188727.55, 0.01 ),
        ( "Net Revenue YoY (H2 2025)", CALCULATE ( [Net Revenue YoY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), -731270.5000000019, 0.01 ),
        ( "Net Revenue YoY % (H2 2025)", CALCULATE ( [Net Revenue YoY %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), -0.07177250509559474, 1e-09 ),
        ( "Sales Revenue (H2 2025)", CALCULATE ( [Sales Revenue], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 9840827.879999999, 0.01 ),
        ( "Returns Value (H2 2025)", CALCULATE ( [Returns Value], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 383370.82999999996, 0.01 ),
        ( "Gross Margin (H2 2025)", CALCULATE ( [Gross Margin], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 3525708.4499999993, 0.01 ),
        ( "Gross Margin % (H2 2025)", CALCULATE ( [Gross Margin %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 0.3727966652515752, 1e-09 ),
        ( "Gross Margin PY (H2 2025)", CALCULATE ( [Gross Margin PY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 3962593.91, 0.01 ),
        ( "Transactions (H2 2025)", CALCULATE ( [Transactions], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 216027.0, 0 ),
        ( "Transactions PY (H2 2025)", CALCULATE ( [Transactions PY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 229446.0, 0 ),
        ( "Units (H2 2025)", CALCULATE ( [Units], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 457916.0, 0 ),
        ( "UPT (H2 2025)", CALCULATE ( [UPT], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 2.119716516916867, 1e-09 ),
        ( "ASP (H2 2025)", CALCULATE ( [ASP], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 21.4905, 1e-09 ),
        ( "Average Transaction Value (H2 2025)", CALCULATE ( [Average Transaction Value], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 45.5537, 1e-09 ),
        ( "Return Rate (H2 2025)", CALCULATE ( [Return Rate], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 0.03895717257479357, 1e-09 ),
        ( "Promotion Share (H2 2025)", CALCULATE ( [Promotion Share], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 0.1690291741999252, 1e-09 ),
        ( "Discount Rate (H2 2025)", CALCULATE ( [Discount Rate], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 0.05268068341159263, 1e-09 ),
        ( "Availability (H2 2025)", CALCULATE ( [Availability], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 0.9477416534754729, 1e-09 ),
        ( "Availability PY (H2 2025)", CALCULATE ( [Availability PY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 0.9542475525015773, 1e-09 ),
        ( "Target Achievement % (H2 2025)", CALCULATE ( [Target Achievement %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2" ), 0.8663816777879156, 1e-09 ),
        ( "Net Revenue (H2 2024, direct filter)", CALCULATE ( [Net Revenue], 'Date'[retail_year] = 2024, 'Date'[retail_half] = "H2" ), 10188727.55, 0.01 ),
        ( "S03 Net Revenue YoY", CALCULATE ( [Net Revenue YoY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_id] = "S03" ), -171317.05, 0.01 ),
        ( "S03 Transactions YoY %", CALCULATE ( [Transactions YoY %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_id] = "S03" ), -0.2958006090719667, 1e-09 ),
        ( "S04 Net Revenue YoY", CALCULATE ( [Net Revenue YoY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_id] = "S04" ), -153952.51999999996, 0.01 ),
        ( "S04 Transactions YoY %", CALCULATE ( [Transactions YoY %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_id] = "S04" ), -0.26576237126350166, 1e-09 ),
        ( "S05 Net Revenue YoY", CALCULATE ( [Net Revenue YoY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_id] = "S05" ), -124702.41000000003, 0.01 ),
        ( "S05 Transactions YoY %", CALCULATE ( [Transactions YoY %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_id] = "S05" ), -0.2692677301556794, 1e-09 ),
        ( "Investigated cluster Transactions YoY %", CALCULATE ( [Transactions YoY %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_group] = "Investigated cluster" ), -0.2775719987366124, 1e-09 ),
        ( "Matched control Transactions YoY %", CALCULATE ( [Transactions YoY %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Store[store_group] = "Matched control" ), -0.011147951415908297, 1e-09 ),
        ( "Electronics & Tech Net Revenue YoY", CALCULATE ( [Net Revenue YoY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[category] = "Electronics & Tech" ), -268518.3299999996, 0.01 ),
        ( "Electronics & Tech Availability", CALCULATE ( [Availability], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[category] = "Electronics & Tech" ), 0.8928076843749079, 1e-09 ),
        ( "Electronics & Tech Availability PY", CALCULATE ( [Availability PY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[category] = "Electronics & Tech" ), 0.9537961458091478, 1e-09 ),
        ( "Voltix Distribution Ltd Full-Week Stock-Outs", CALCULATE ( [Full-Week Stock-Outs], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[supplier_name] = "Voltix Distribution Ltd" ), 674.0, 0 ),
        ( "Voltix Distribution Ltd Full-Week Stock-Outs PY", CALCULATE ( [Full-Week Stock-Outs PY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[supplier_name] = "Voltix Distribution Ltd" ), 0.0, 0 ),
        ( "Electronics & Tech 'Faulty' Returns Value YoY", CALCULATE ( [Returns Value YoY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[category] = "Electronics & Tech", Returns[return_reason] = "Faulty" ), 31588.729999999996, 0.01 ),
        ( "Home & Kitchen Discount Rate", CALCULATE ( [Discount Rate], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[category] = "Home & Kitchen" ), 0.11904605637292083, 1e-09 ),
        ( "Home & Kitchen Discount Rate PY", CALCULATE ( [Discount Rate PY], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[category] = "Home & Kitchen" ), 0.023628071891495638, 1e-09 ),
        ( "Week 30 Net Revenue PY", CALCULATE ( [Net Revenue PY], 'Date'[retail_year] = 2025, 'Date'[retail_week] = 30 ), 297402.62, 0.01 ),
        ( "Sep 2025 sale cohort: returns by sale date (Faulty, E&T)", CALCULATE ( [Returns Value (by Sale Date)], 'Date'[year_month] = 202509, Product[category] = "Electronics & Tech", Returns[return_reason] = "Faulty" ), 10940.570000000002, 0.01 ),
        ( "Guard: Net Revenue blank under a Promotion filter (1 = blank)", IF ( ISBLANK ( CALCULATE ( [Net Revenue], Promotion[member_type] = "Promotion" ) ), 1, 0 ), 1.0, 0 ),
        ( "Guard: Target Achievement blank under a category filter (1 = blank)", IF ( ISBLANK ( CALCULATE ( [Target Achievement %], 'Date'[retail_year] = 2025, 'Date'[retail_half] = "H2", Product[category] = "Electronics & Tech" ) ), 1, 0 ), 1.0, 0 ),
        ( "P6: High-Seller Share of Lost Sales", [High-Seller Share of Lost Sales (P6)], 0.6104697598962949, 1e-06 ),
        ( "P6: Top SKU Share of Lost Sales", [Top SKU Share of Lost Sales (P6)], 0.2479586914966241, 1e-06 ),
        ( "P6: Top 3 SKU Share of Lost Sales", [Top 3 SKU Share of Lost Sales (P6)], 0.4976519444138398, 1e-06 ),
        ( "P6: Lost Sales Gross", [Lost Sales Gross (P6)], 37235.346776, 1e-06 ),
        ( "P6: Lost Sales Net of Deferred Demand", [Lost Sales Net of Deferred Demand (P6)], 23963.216711, 1e-06 ),
        ( "P6: Lost Sales Range Low", [Lost Sales Range Low (P6)], 23963.216711, 1e-06 ),
        ( "P6: Lost Sales Range High", [Lost Sales Range High (P6)], 44460.376486, 1e-06 ),
        ( "P6: Cluster Excess", [Cluster Excess (P6)], -397778.209303, 1e-06 ),
        ( "P6: Voltix Distribution Ltd episodes H2 2025", CALCULATE ( [Stock-Out Episodes (P6)], p6_et_episodes[supplier_name] = "Voltix Distribution Ltd", p6_et_episodes[retail_year] = 2025 ), 1181.0, 1e-06 ),
        ( "P6: Promotion events H2 2025", CALCULATE ( [Promotion Events (P6)], p6_hk_events_by_year[retail_year] = 2025 ), 8848.0, 1e-06 ),
        ( "P6: HK Method Effect total is blank (1 = blank)", IF ( ISBLANK ( [HK Method Effect Guarded] ), 1, 0 ), 1.0, 1e-06 ),
        ( "P6: Driver Impact total is blank (1 = blank)", IF ( ISBLANK ( [Driver Impact (single driver)] ), 1, 0 ), 1.0, 1e-06 ),
        ( "Attribution total (Phase 6 table) = H2 change", [Attribution Total], -731270.5, 0.01 )
    }
RETURN
    SELECTCOLUMNS (
        _cases,
        "Check", [Value1],
        "Power BI", [Value2],
        "Expected", [Value3],
        "Difference", [Value2] - [Value3],
        "Status", IF ( ABS ( [Value2] - [Value3] ) <= [Value4], "PASS", "FAIL" )
    )
ORDER BY [Status], [Check]

// Second query: the fixed-context QA measures and the attribution check text.
EVALUATE
ROW (
    "QA Net Revenue H2 2025", [QA Net Revenue H2 2025],
    "QA Net Revenue H2 2024", [QA Net Revenue H2 2024],
    "QA Attribution Check", [QA Attribution Check]
)
