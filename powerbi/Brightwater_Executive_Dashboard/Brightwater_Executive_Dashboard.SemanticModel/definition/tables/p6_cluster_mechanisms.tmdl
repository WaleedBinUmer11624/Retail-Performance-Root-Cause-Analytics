table p6_cluster_mechanisms

	column metric
		dataType: string
		sourceColumn: metric

	column cluster_py
		dataType: double
		summarizeBy: none
		sourceColumn: cluster_py

	column cluster_cy
		dataType: double
		summarizeBy: none
		sourceColumn: cluster_cy

	column control_py
		dataType: double
		summarizeBy: none
		sourceColumn: control_py

	column control_cy
		dataType: double
		summarizeBy: none
		sourceColumn: control_cy

	column unit
		dataType: string
		sourceColumn: unit

	column cluster_change
		dataType: double
		summarizeBy: none
		sourceColumn: cluster_change

	column control_change
		dataType: double
		summarizeBy: none
		sourceColumn: control_change

	column difference
		dataType: double
		summarizeBy: none
		sourceColumn: difference

	partition p6_cluster_mechanisms = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AnalyticsFolder & "\p6_cluster_mechanisms.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"metric", type text},
			        {"cluster_py", type number},
			        {"cluster_cy", type number},
			        {"control_py", type number},
			        {"control_cy", type number},
			        {"unit", type text},
			        {"cluster_change", type number},
			        {"control_change", type number},
			        {"difference", type number}
			    }, "en-US")
			in
			    Typed
