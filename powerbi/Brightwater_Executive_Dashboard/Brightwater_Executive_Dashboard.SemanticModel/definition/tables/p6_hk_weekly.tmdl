table p6_hk_weekly

	column retail_week
		dataType: int64
		summarizeBy: none
		sourceColumn: retail_week

	column sales_revenue_cy
		dataType: double
		summarizeBy: none
		sourceColumn: sales_revenue_cy

	column sales_revenue_py
		dataType: double
		summarizeBy: none
		sourceColumn: sales_revenue_py

	column counterfactual_m1
		dataType: double
		summarizeBy: none
		sourceColumn: counterfactual_m1

	column promo_coverage_cy
		dataType: double
		summarizeBy: none
		sourceColumn: promo_coverage_cy

	column promo_coverage_py
		dataType: double
		summarizeBy: none
		sourceColumn: promo_coverage_py

	column discount_depth_cy
		dataType: double
		summarizeBy: none
		sourceColumn: discount_depth_cy

	column discount_depth_py
		dataType: double
		summarizeBy: none
		sourceColumn: discount_depth_py

	partition p6_hk_weekly = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AnalyticsFolder & "\p6_hk_weekly.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"retail_week", Int64.Type},
			        {"sales_revenue_cy", type number},
			        {"sales_revenue_py", type number},
			        {"counterfactual_m1", type number},
			        {"promo_coverage_cy", type number},
			        {"promo_coverage_py", type number},
			        {"discount_depth_cy", type number},
			        {"discount_depth_py", type number}
			    }, "en-US")
			in
			    Typed
