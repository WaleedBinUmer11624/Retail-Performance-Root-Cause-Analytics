table Sales

	column sales_line_id
		dataType: int64
		summarizeBy: none
		sourceColumn: sales_line_id

	column date_key
		dataType: int64
		summarizeBy: none
		sourceColumn: date_key
		isHidden

	column store_key
		dataType: int64
		summarizeBy: none
		sourceColumn: store_key
		isHidden

	column product_key
		dataType: int64
		summarizeBy: none
		sourceColumn: product_key
		isHidden

	column promotion_key
		dataType: int64
		summarizeBy: none
		sourceColumn: promotion_key
		isHidden

	column transaction_key
		dataType: int64
		summarizeBy: none
		sourceColumn: transaction_key
		isHidden

	column quantity
		dataType: int64
		summarizeBy: none
		sourceColumn: quantity

	column gross_amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: gross_amount

	column discount_amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: discount_amount

	column sales_revenue
		dataType: decimal
		summarizeBy: none
		sourceColumn: sales_revenue

	column cost_amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: cost_amount

	column is_promoted
		dataType: int64
		summarizeBy: none
		sourceColumn: is_promoted

	partition Sales = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(ModelFolder & "\sales.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"sales_line_id", Int64.Type},
			        {"date_key", Int64.Type},
			        {"store_key", Int64.Type},
			        {"product_key", Int64.Type},
			        {"promotion_key", Int64.Type},
			        {"transaction_key", Int64.Type},
			        {"quantity", Int64.Type},
			        {"gross_amount", Currency.Type},
			        {"discount_amount", Currency.Type},
			        {"sales_revenue", Currency.Type},
			        {"cost_amount", Currency.Type},
			        {"is_promoted", Int64.Type}
			    }, "en-US")
			in
			    Typed
