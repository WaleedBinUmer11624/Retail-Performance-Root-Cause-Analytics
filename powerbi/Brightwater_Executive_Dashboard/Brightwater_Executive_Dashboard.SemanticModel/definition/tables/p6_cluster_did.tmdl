table p6_cluster_did

	column control_group
		dataType: string
		sourceColumn: control_group

	column outcome
		dataType: string
		sourceColumn: outcome

	column did_log
		dataType: double
		summarizeBy: none
		sourceColumn: did_log

	column did_pct
		dataType: double
		summarizeBy: none
		sourceColumn: did_pct

	column pre_gap_mean_log
		dataType: double
		summarizeBy: none
		sourceColumn: pre_gap_mean_log

	column post_gap_mean_log
		dataType: double
		summarizeBy: none
		sourceColumn: post_gap_mean_log

	column pre_trend_slope
		dataType: double
		summarizeBy: none
		sourceColumn: pre_trend_slope

	column pre_trend_p
		dataType: double
		summarizeBy: none
		sourceColumn: pre_trend_p

	column ratio_did_actual
		dataType: double
		summarizeBy: none
		sourceColumn: ratio_did_actual

	column ratio_did_counterfactual
		dataType: double
		summarizeBy: none
		sourceColumn: ratio_did_counterfactual

	column ratio_did_excess
		dataType: double
		summarizeBy: none
		sourceColumn: ratio_did_excess

	column control_yoy
		dataType: double
		summarizeBy: none
		sourceColumn: control_yoy

	column pre_gap_ratio
		dataType: double
		summarizeBy: none
		sourceColumn: pre_gap_ratio

	partition p6_cluster_did = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AnalyticsFolder & "\p6_cluster_did.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"control_group", type text},
			        {"outcome", type text},
			        {"did_log", type number},
			        {"did_pct", type number},
			        {"pre_gap_mean_log", type number},
			        {"post_gap_mean_log", type number},
			        {"pre_trend_slope", type number},
			        {"pre_trend_p", type number},
			        {"ratio_did_actual", type number},
			        {"ratio_did_counterfactual", type number},
			        {"ratio_did_excess", type number},
			        {"control_yoy", type number},
			        {"pre_gap_ratio", type number}
			    }, "en-US")
			in
			    Typed
