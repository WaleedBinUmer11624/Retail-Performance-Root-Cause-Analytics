table p6_faulty_concentration

	column dimension
		dataType: string
		sourceColumn: dimension

	column entities
		dataType: int64
		summarizeBy: none
		sourceColumn: entities

	column entities_with_increase
		dataType: int64
		summarizeBy: none
		sourceColumn: entities_with_increase

	column net_increase
		dataType: double
		summarizeBy: none
		sourceColumn: net_increase

	column gross_increase
		dataType: double
		summarizeBy: none
		sourceColumn: gross_increase

	column top_k
		dataType: int64
		summarizeBy: none
		sourceColumn: top_k

	column top_k_share_of_gross
		dataType: double
		summarizeBy: none
		sourceColumn: top_k_share_of_gross

	column top_entities
		dataType: string
		sourceColumn: top_entities

	column hhi_of_increase
		dataType: double
		summarizeBy: none
		sourceColumn: hhi_of_increase

	column entities_significant_p01
		dataType: int64
		summarizeBy: none
		sourceColumn: entities_significant_p01

	partition p6_faulty_concentration = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AnalyticsFolder & "\p6_faulty_concentration.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"dimension", type text},
			        {"entities", Int64.Type},
			        {"entities_with_increase", Int64.Type},
			        {"net_increase", type number},
			        {"gross_increase", type number},
			        {"top_k", Int64.Type},
			        {"top_k_share_of_gross", type number},
			        {"top_entities", type text},
			        {"hhi_of_increase", type number},
			        {"entities_significant_p01", Int64.Type}
			    }, "en-US")
			in
			    Typed
