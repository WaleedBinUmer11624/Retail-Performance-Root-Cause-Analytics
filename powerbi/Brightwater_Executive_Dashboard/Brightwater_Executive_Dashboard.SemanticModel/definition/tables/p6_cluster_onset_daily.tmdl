table p6_cluster_onset_daily

	column calendar_date
		dataType: string
		sourceColumn: calendar_date

	column gap_log
		dataType: double
		summarizeBy: none
		sourceColumn: gap_log

	partition p6_cluster_onset_daily = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AnalyticsFolder & "\p6_cluster_onset_daily.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"calendar_date", type text},
			        {"gap_log", type number}
			    }, "en-US")
			in
			    Typed
