table p6_perimeter

	column store_group
		dataType: string
		sourceColumn: store_group

	column category_group
		dataType: string
		sourceColumn: category_group

	column net_revenue_py
		dataType: double
		summarizeBy: none
		sourceColumn: net_revenue_py

	column net_revenue_cy
		dataType: double
		summarizeBy: none
		sourceColumn: net_revenue_cy

	column net_revenue_change
		dataType: double
		summarizeBy: none
		sourceColumn: net_revenue_change

	partition p6_perimeter = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AnalyticsFolder & "\p6_perimeter.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"store_group", type text},
			        {"category_group", type text},
			        {"net_revenue_py", type number},
			        {"net_revenue_cy", type number},
			        {"net_revenue_change", type number}
			    }, "en-US")
			in
			    Typed
