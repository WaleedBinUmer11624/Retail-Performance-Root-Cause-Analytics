	partition dq_store_week_health = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DqFolder & "\dq_store_week_health.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"store_id", type text}, {"retail_week_key", Int64.Type}, {"t", Int64.Type}, {"trading_days", Int64.Type}, {"days_asat", Int64.Type}, {"lines", Int64.Type}, {"lines_asat", Int64.Type}, {"lines_trailing_median", type number}, {"C2_ontime_share", type number}, {"n_dup", Int64.Type}, {"n_price", Int64.Type}, {"n_discount", Int64.Type}, {"n_quarantine", Int64.Type}, {"n_missing_snapshots", Int64.Type}, {"snapshot_rows", Int64.Type}, {"lines_unknown_product", Int64.Type}, {"lines_dq_flagged", Int64.Type}, {"returns_unlinked", Int64.Type}, {"lines_expected", type number}, {"lines_missing", Int64.Type}, {"C1", type logical}, {"C2", type logical}, {"C3", type logical}, {"C4", type logical}, {"C5", type logical}, {"C6", type logical}, {"C7", type logical}, {"C8", type logical}, {"C9", type logical}, {"C10", type logical}, {"C11", type logical}, {"dq_sales_status", type text}, {"dq_inventory_status", type text}, {"dq_checks_failed", type text}
			    }, "en-US")
			in
			    Typed
