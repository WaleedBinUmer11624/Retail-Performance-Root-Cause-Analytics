table p6_cluster_onset_by_store

	column store_id
		dataType: string
		sourceColumn: store_id

	column onset_date
		dataType: string
		sourceColumn: onset_date

	column shift_log
		dataType: double
		summarizeBy: none
		sourceColumn: shift_log

	column shift_pct
		dataType: double
		summarizeBy: none
		sourceColumn: shift_pct

	column r2
		dataType: double
		summarizeBy: none
		sourceColumn: r2

	partition p6_cluster_onset_by_store = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AnalyticsFolder & "\p6_cluster_onset_by_store.csv"),
			                          [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"store_id", type text},
			        {"onset_date", type text},
			        {"shift_log", type number},
			        {"shift_pct", type number},
			        {"r2", type number}
			    }, "en-US")
			in
			    Typed
