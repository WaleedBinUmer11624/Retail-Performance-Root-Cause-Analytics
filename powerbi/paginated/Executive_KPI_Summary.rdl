<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BrightwaterRetail">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=BrightwaterRetail;Encrypt=True;TrustServerCertificate=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>c1808d18-6f95-5ec1-8260-58c94e350a2a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Gate">
      <Query>
        <DataSourceName>BrightwaterRetail</DataSourceName>
        <CommandText>SELECT check_set, checks, passed, expected_checks, gate_status
FROM rpt.v_validation_gate
ORDER BY check_set DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="check_set">
          <DataField>check_set</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="checks">
          <DataField>checks</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="passed">
          <DataField>passed</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="expected_checks">
          <DataField>expected_checks</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="gate_status">
          <DataField>gate_status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Estate">
      <Query>
        <DataSourceName>BrightwaterRetail</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Half">
            <Value>=Parameters!Half.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT retail_year, period, segment_name, net_revenue_cy, net_revenue_py, net_revenue_change,
       net_revenue_yoy_pct, sales_revenue_cy, sales_revenue_py, returns_value_cy, returns_value_py,
       transactions_cy, transactions_py, transactions_yoy_pct, aov_cy, aov_py,
       gross_margin_pct_cy, gross_margin_pct_py
FROM rpt.v_estate_yoy
WHERE retail_year = @Year AND period = @Half;</CommandText>
      </Query>
      <Fields>
        <Field Name="retail_year">
          <DataField>retail_year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="period">
          <DataField>period</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="segment_name">
          <DataField>segment_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="net_revenue_cy">
          <DataField>net_revenue_cy</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="net_revenue_py">
          <DataField>net_revenue_py</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="net_revenue_change">
          <DataField>net_revenue_change</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="net_revenue_yoy_pct">
          <DataField>net_revenue_yoy_pct</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="sales_revenue_cy">
          <DataField>sales_revenue_cy</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="sales_revenue_py">
          <DataField>sales_revenue_py</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="returns_value_cy">
          <DataField>returns_value_cy</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="returns_value_py">
          <DataField>returns_value_py</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="transactions_cy">
          <DataField>transactions_cy</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="transactions_py">
          <DataField>transactions_py</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="transactions_yoy_pct">
          <DataField>transactions_yoy_pct</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="aov_cy">
          <DataField>aov_cy</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="aov_py">
          <DataField>aov_py</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="gross_margin_pct_cy">
          <DataField>gross_margin_pct_cy</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="gross_margin_pct_py">
          <DataField>gross_margin_pct_py</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Stores">
      <Query>
        <DataSourceName>BrightwaterRetail</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Half">
            <Value>=Parameters!Half.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Store">
            <Value>=Parameters!Store.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT store_label, net_revenue_cy, net_revenue_py, net_revenue_change, net_revenue_yoy_pct,
       transactions_cy, transactions_py, transactions_yoy_pct, aov_cy, gross_margin_pct_cy
FROM rpt.v_store_yoy
WHERE retail_year = @Year AND period = @Half
  AND (@Store = N'ALL' OR store_label = @Store)
ORDER BY net_revenue_change, store_label;</CommandText>
      </Query>
      <Fields>
        <Field Name="store_label">
          <DataField>store_label</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="net_revenue_cy">
          <DataField>net_revenue_cy</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="net_revenue_py">
          <DataField>net_revenue_py</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="net_revenue_change">
          <DataField>net_revenue_change</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="net_revenue_yoy_pct">
          <DataField>net_revenue_yoy_pct</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="transactions_cy">
          <DataField>transactions_cy</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="transactions_py">
          <DataField>transactions_py</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="transactions_yoy_pct">
          <DataField>transactions_yoy_pct</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="aov_cy">
          <DataField>aov_cy</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="gross_margin_pct_cy">
          <DataField>gross_margin_pct_cy</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YearList">
      <Query>
        <DataSourceName>BrightwaterRetail</DataSourceName>
        <CommandText>SELECT DISTINCT retail_year
FROM rpt.v_period_parameter
ORDER BY retail_year;</CommandText>
      </Query>
      <Fields>
        <Field Name="retail_year">
          <DataField>retail_year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="StoreList">
      <Query>
        <DataSourceName>BrightwaterRetail</DataSourceName>
        <CommandText>SELECT N'ALL' AS store_value, N'All stores' AS store_display, 0 AS sort_order
UNION ALL
SELECT store_label, store_label, 1
FROM rpt.v_store_parameter
ORDER BY sort_order, store_display;</CommandText>
      </Query>
      <Fields>
        <Field Name="store_value">
          <DataField>store_value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="store_display">
          <DataField>store_display</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="sort_order">
          <DataField>sort_order</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Brightwater Retail: Executive KPI Summary</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1F3A5F</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Title</rd:DefaultName>
            <Top>0in</Top>
            <Left>0in</Left>
            <Height>0.4in</Height>
            <Width>10.9in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>4pt</PaddingLeft>
              <PaddingRight>4pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="Subtitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Retail half " &amp; Parameters!Half.Value &amp; " " &amp; CStr(Parameters!Year.Value) &amp; " against " &amp; Parameters!Half.Value &amp; " " &amp; CStr(Parameters!Year.Value - 1) &amp; ".  Stores: " &amp; Parameters!Store.Label &amp; ".  Source: SQL Server BrightwaterRetail, schema rpt."</Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                      <Color>#5B6472</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Subtitle</rd:DefaultName>
            <Top>0.4in</Top>
            <Left>0in</Left>
            <Height>0.25in</Height>
            <Width>10.9in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>4pt</PaddingLeft>
              <PaddingRight>4pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="GateBanner">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=IIF(Sum(IIF(Fields!gate_status.Value = "PASS", 1, 0), "Gate") = 2, "Validation gate PASS: reconciliation 45/45 and KPI validation 38/38. Figures match the governed numbers; safe to export.", "VALIDATION GATE FAILED: do not export or share this report.")</Value>
                    <Style>
                      <FontSize>9.5pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>=IIF(Sum(IIF(Fields!gate_status.Value = "PASS", 1, 0), "Gate") = 2, "#1B7A3A", "#B42318")</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>GateBanner</rd:DefaultName>
            <Top>0.75in</Top>
            <Left>0in</Left>
            <Height>0.3in</Height>
            <Width>10.9in</Width>
            <Style>
              <Border>
                <Color>#D5DAE1</Color>
                <Style>Solid</Style>
                <Width>0.5pt</Width>
              </Border>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>4pt</PaddingLeft>
              <PaddingRight>4pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="PartialNote">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Note: the data ends in early 2026, so 2026 H1 is a partial half and its change against 2025 H1 is not comparable.</Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                      <Color>#B42318</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>PartialNote</rd:DefaultName>
            <Top>1.08in</Top>
            <Left>0in</Left>
            <Height>0.25in</Height>
            <Width>10.9in</Width>
            <Visibility>
              <Hidden>=Parameters!Year.Value &lt;&gt; 2026</Hidden>
            </Visibility>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>4pt</PaddingLeft>
              <PaddingRight>4pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
